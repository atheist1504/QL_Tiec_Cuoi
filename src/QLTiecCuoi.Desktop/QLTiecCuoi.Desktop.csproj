<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\QLTiecCuoi.Shared\QLTiecCuoi.Shared.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Icon của file .exe (Explorer, thanh tác vụ, lối tắt) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>Quản lý nhà hàng tiệc cưới</AssemblyTitle>
    <Product>QL Tiệc Cưới</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon góc trái các cửa sổ -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
