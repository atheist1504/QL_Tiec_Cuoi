<Window x:Class="QLTiecCuoi.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý nhà hàng tiệc cưới – Lịch sảnh" Height="640" Width="1100"
        WindowStartupLocation="CenterScreen" FontSize="14" Loaded="Window_Loaded">
    <DockPanel Margin="16">
        <!-- Thanh công cụ -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Lịch sảnh theo ca" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,24,0"/>
            <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker x:Name="FromPicker" Width="140" SelectedDateFormat="Short"/>
            <TextBlock Text="Số ngày:" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <ComboBox x:Name="DaysBox" Width="70" SelectedIndex="0">
                <ComboBoxItem Content="7"/>
                <ComboBoxItem Content="14"/>
                <ComboBoxItem Content="31"/>
            </ComboBox>
            <Button Content="Xem lịch" Padding="16,4" Margin="16,0,0,0" Click="Load_Click"/>
            <Button Content="Tuần sau ›" Padding="12,4" Margin="8,0,0,0" Click="Next_Click"/>
        </StackPanel>

        <!-- Chú thích màu -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Border Background="#E3F4E6" Width="16" Height="16" CornerRadius="3"/>
            <TextBlock Text="Còn trống" Margin="6,0,16,0"/>
            <Border Background="#FFF1C9" Width="16" Height="16" CornerRadius="3"/>
            <TextBlock Text="Đang giữ chỗ" Margin="6,0,16,0"/>
            <Border Background="#F8D7DA" Width="16" Height="16" CornerRadius="3"/>
            <TextBlock Text="Đã đặt cọc" Margin="6,0,16,0"/>
            <TextBlock Text="· Bấm vào ô để giữ sảnh hoặc hủy giữ chỗ" Foreground="Gray"/>
        </StackPanel>

        <!-- Thanh trạng thái -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="Gray"/>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="False" CanUserReorderColumns="False"
                  SelectionMode="Single" SelectionUnit="Cell" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                  RowHeight="40" Background="White" BorderBrush="#DDD">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ngày" Binding="{Binding DateText}" Width="105"/>
                <DataGridTextColumn Header="Thứ" Binding="{Binding DayText}" Width="95"/>
                <DataGridTextColumn Header="Ca" Binding="{Binding ShiftText}" Width="55"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
