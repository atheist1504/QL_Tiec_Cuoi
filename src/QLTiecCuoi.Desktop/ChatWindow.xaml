<Window x:Class="QLTiecCuoi.Desktop.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trợ lý AI – tra lịch sảnh, báo giá" Height="680" Width="560"
        WindowStartupLocation="Manual" FontSize="14">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Hội thoại mới" Padding="10,3" Click="NewChat_Click"/>
            <TextBlock Text="Hỏi bằng tiếng Việt. Thao tác giữ sảnh, lưu báo giá luôn cần bạn xác nhận."
                       Foreground="Gray" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Ô nhập -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Gửi" Width="70" Margin="8,0,0,0" Click="Send_Click"/>
            <TextBox x:Name="InputBox" Height="60" Padding="6" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputBox_PreviewKeyDown"/>
        </DockPanel>

        <!-- Gợi ý câu hỏi -->
        <WrapPanel x:Name="Suggestions" DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Thứ Bảy tuần sau còn sảnh nào cho 40 bàn?" Padding="8,2" Margin="0,0,6,6" Click="Suggestion_Click"/>
            <Button Content="Báo giá thử 35 bàn sảnh Hoàng Gia" Padding="8,2" Margin="0,0,6,6" Click="Suggestion_Click"/>
            <Button Content="Thực đơn có những món gì?" Padding="8,2" Margin="0,0,6,6" Click="Suggestion_Click"/>
            <Button Content="2 tuần tới có những tiệc nào, đã cọc chưa?" Padding="8,2" Margin="0,0,6,6" Click="Suggestion_Click"/>
            <Button Content="Lượt giữ chỗ nào sắp hết hạn?" Padding="8,2" Margin="0,0,6,6" Click="Suggestion_Click"/>
        </WrapPanel>

        <!-- Thao tác chờ xác nhận -->
        <Border x:Name="PendingPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,8,0,0" Padding="10"
                Background="#FFF1C9" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Trợ lý đề xuất thao tác sau, cần bạn xác nhận:" FontWeight="SemiBold"/>
                <ItemsControl x:Name="PendingList" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,2">
                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Details, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Xác nhận" Padding="14,4" Click="Approve_Click"/>
                    <Button Content="Từ chối" Padding="14,4" Margin="8,0,0,0" Click="Decline_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Hội thoại -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Background="#FAFAFA">
            <ItemsControl x:Name="MessageList" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Background}" HorizontalAlignment="{Binding Align}" CornerRadius="8"
                                Padding="10,6" Margin="0,4" MaxWidth="420">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="Gray" Margin="0,4,0,0"
                                           Visibility="{Binding MetaVisibility}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
