<Window x:Class="QLTiecCuoi.Desktop.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thực đơn và dịch vụ" Height="560" Width="820"
        WindowStartupLocation="CenterOwner" FontSize="14">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                   Text="Sửa trực tiếp trong bảng, nhấn Enter để lưu dòng. Thêm mới ở dòng trống cuối bảng. Bỏ chọn &quot;Đang dùng&quot; để ngừng bán (báo giá cũ không bị ảnh hưởng)."/>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="Gray"/>
        <TabControl>
            <TabItem Header="Thực đơn">
                <DataGrid x:Name="MenuGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="False"
                          RowEditEnding="MenuGrid_RowEditEnding" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên món" Binding="{Binding Name}" Width="*"/>
                        <DataGridComboBoxColumn x:Name="CategoryColumn" Header="Nhóm" SelectedValueBinding="{Binding Category}"
                                                SelectedValuePath="Tag" DisplayMemberPath="Content" Width="140"/>
                        <DataGridTextColumn Header="Giá/bàn (đ)" Binding="{Binding PricePerTable, StringFormat=N0, ConverterCulture=vi-VN}" Width="140"/>
                        <DataGridCheckBoxColumn Header="Đang dùng" Binding="{Binding IsActive}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Dịch vụ">
                <DataGrid x:Name="ServiceGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="False"
                          RowEditEnding="ServiceGrid_RowEditEnding" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="90"/>
                        <DataGridTextColumn Header="Giá (đ)" Binding="{Binding Price, StringFormat=N0, ConverterCulture=vi-VN}" Width="140"/>
                        <DataGridCheckBoxColumn Header="Đang dùng" Binding="{Binding IsActive}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
