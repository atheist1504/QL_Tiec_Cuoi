<Window x:Class="QLTiecCuoi.Desktop.LiquidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh lý hợp đồng" Height="640" Width="980"
        WindowStartupLocation="CenterOwner" FontSize="14">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nhập số liệu thực tế -->
        <DockPanel Grid.Column="0">
            <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="InfoText" DockPanel.Dock="Top" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,12"/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBlock Text="Số bàn thực tế *" VerticalAlignment="Center" Width="130"/>
                <TextBox x:Name="TablesBox" Width="80" Padding="3" TextAlignment="Right"/>
                <TextBlock x:Name="TablesHint" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="Khoản phát sinh (thêm đồ uống, phụ thu...)" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <TextBlock DockPanel.Dock="Bottom" Text="Ghi chú" Margin="0,12,0,4"/>
            <TextBox x:Name="NoteBox" DockPanel.Dock="Bottom" Height="50" Padding="3" TextWrapping="Wrap" AcceptsReturn="True"
                     Margin="0,0,0,0"/>
            <DataGrid x:Name="ExtrasGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                      HeadersVisibility="Column" Background="White" CellEditEnding="ExtrasGrid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nội dung" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Số tiền (đ)" Binding="{Binding Amount}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Kết quả quyết toán -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Quyết toán" FontSize="17" FontWeight="SemiBold"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="ConfirmButton" Content="Xác nhận thanh lý" Padding="16,6" IsEnabled="False" Click="Confirm_Click"/>
                <Button Content="Đóng" Padding="16,6" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="#B00020" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Border DockPanel.Dock="Bottom" x:Name="ResultBanner" Margin="0,8,0,0" Padding="10,8" CornerRadius="4" Background="#F3F3F3">
                <TextBlock x:Name="ResultText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <DataGrid x:Name="BreakdownGrid" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="None" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Label}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="4,3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Strong}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Value}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="4,3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Strong}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
